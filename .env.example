# Copie para .env e ajuste. O .env nao vai para o git.
# Todos os valores abaixo sao os padroes do codigo: o arquivo funciona como
# esta para desenvolvimento local.

# --- Banco de dados -------------------------------------------------------
# Estes valores tambem alimentam o servico postgres do compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=pergunteme_juri
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternativa a`s cinco variaveis acima; tem precedencia sobre elas.
# DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/pergunteme_juri

# Loga todo SQL executado (util para depurar, ruidoso no dia a dia).
SQL_ECHO=0

# --- Embeddings e chunking ------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Pasta com os PDFs das leis, relativa a backend/.
DOC_FOLDER=leis
CHUNK_SIZE=256
OVERLAP=0.15

# --- Busca hibrida --------------------------------------------------------
# Quantos trechos a busca devolve por consulta.
RAG_LIMIT=10

# --- Servidor MCP (hrag.py) ----------------------------------------------
MCP_HOST=localhost
MCP_PORT=8000
# Endereco que o juri.py usa para chegar ao hrag.py. Dentro de um container,
# localhost e o proprio container: use host.docker.internal ou o nome do
# servico no compose.
MCP_URL=http://localhost:8000/mcp

# --- LLM (juri.py) --------------------------------------------------------
# Mesma ressalva sobre localhost dentro de container.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.7
LLM_NUM_CTX=8192
# Bloco <think> do qwen3: mais lento, porem melhor em perguntas que exigem
# encadear regras.
LLM_REASONING=0

# --- Memoria de conversa --------------------------------------------------
# Derivado de DATABASE_URL/POSTGRES_* removendo o dialeto do SQLAlchemy.
# Sobrescreva so se o checkpointer usar outro banco.
# CHECKPOINT_URL=postgresql://postgres:root@localhost:5432/pergunteme_juri

# --- Somente para docker compose ------------------------------------------
# Como os containers alcancam o Ollama do host. Nome distinto de
# OLLAMA_BASE_URL porque aquele vale para execucao local, onde e localhost.
# OLLAMA_URL_DOCKER=http://host.docker.internal:11434
